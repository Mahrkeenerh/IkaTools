{
  "manifest_version": 3,
  "name": "Ikariam Tools",
  "version": "2.3",
  "description": "Removes premium UI clutter, auto-solves piracy captchas, and scans world maps",
  "permissions": ["offscreen", "storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ikariam Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ikariam.gameforge.com/*"],
      "js": ["utils.js", "cleanup.js", "content.js", "maprender.js", "scanner.js", "minimap.js", "islandinfo.js", "autofinish.js", "autopirate.js", "advisor.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["model/model.onnx", "dist/*", "bridge.js"],
      "matches": ["*://*.ikariam.gameforge.com/*"]
    }
  ]
}
